coverage/

# Generated store assets — the SVG embeds ~1.2MB of base64 font data.
# Regenerate with: node scripts/make-feature-graphic.mjs
store/feature-graphic.svg
store/feature-graphic@2x.png

# Written by the build poll; a transient URL, not a fact worth tracking.
.aab-url.txt

# Where downloads from a chat session land. The posters that matter live in
